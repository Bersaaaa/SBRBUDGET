# ============================================================
# SBR Budget — variables d'environnement
# Local : copiez ce fichier en .env
# Vercel : Project Settings → Environment Variables
# ============================================================

# Laissez APP_BASE_URL vide sur Vercel (détecté automatiquement),
# ou forcez-le avec votre domaine définitif.
APP_BASE_URL=
ENABLED_PROVIDERS=nickel,creditmutuel

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Sécurité — openssl rand -hex 32 pour chaque valeur
# ------------------------------------------------------------
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=

# ------------------------------------------------------------
# Nickel — Berlin Group NextGenPSD2
# https://psdapistore.nickel.eu/
# Tant que CLIENT_ID / AUTHORIZE_URL / TOKEN_URL sont vides,
# Nickel s'affiche en mode démonstration.
# ------------------------------------------------------------
NICKEL_ENV=sandbox
NICKEL_CLIENT_ID=
NICKEL_CLIENT_SECRET=
NICKEL_REDIRECT_URI=
NICKEL_API_BASE_URL=
NICKEL_AUTHORIZE_URL=
NICKEL_TOKEN_URL=
NICKEL_AIS_SCOPE=AIS
NICKEL_QWAC_CERT=
NICKEL_QWAC_KEY=
NICKEL_TPP_ID=

# ------------------------------------------------------------
# Crédit Mutuel — standard STET
# https://oauth2.creditmutuel.fr/en/devportal/index.html
# Bases publiées : https://oauth2-apisi.e-i.com/cm/
#                  https://oauth2-apisi.e-i.com/sandbox/cm/
# ------------------------------------------------------------
CM_ENV=sandbox
CM_CLIENT_ID=
CM_CLIENT_SECRET=
CM_REDIRECT_URI=
CM_API_BASE_URL=
CM_AUTHORIZE_URL=
CM_TOKEN_URL=
CM_AIS_SCOPE=aisp
CM_QWAC_CERT=
CM_QWAC_KEY=
CM_TPP_ID=
